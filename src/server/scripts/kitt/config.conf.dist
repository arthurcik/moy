##################
# Kitt WHO custom
##################
# static text
# default = 0 (arata lista reala)
Kitt.WHO.msg.enable = 1

#    PreventAFKLogout
#        Description: Prevent players AFK from being logged out
#        Default:     0  - (Disabled)
#                     1  - (Enabled, prevent players AFK from being logged out in Sanctuary zones)
#                     2  - (Enabled, prevent players AFK from being logged out in all zones)
PreventAFKLogout = 2

#    Fake.WHO.List
#        Add fake players to fill in WHO LIST (who is online list, "O" button) if there is less then
#        49 real players online
#        Default: 0 (disabled)
#                 1 (enabled)
Fake.WHO.List = 1
Fake.WHO.Online.Interval = 2
Fake.WHO.LevelUp.Interval = 1

#       Modify Who Count
#       0 = disabled (default)
WhoCountBase = 5

########################################
# Kitt Auto Complete Quests
########################################
# Lista de ID-uri ale quest-urilor care vor fi completate automat la acceptare.
# Foloseste virgula ca separator.
# Default: "" (Niciunul) Ex.: "99,101,7023"
kitt.Quests.AutoCompleteList = ""

# Activeaza/Dezactiveaza completarea automata a reputatiei (1 = Activat, 0 = Dezactivat)
# Defaul: 0
kitt.Quests.AutoReputation.Enable = 0

# Lista de ID-uri ale quest-urilor care AU VOIE sa primeasca reputatie automata (player).
# Ex.: Daca jucatorul are reputatie 3000 si questul cere rep. 6000, la acceptare va primi jucatorul rep. 6000
# Nota: Quest-ul trebuie sa fie prezent si in kitt.Quests.AutoCompleteList!
# Default: "" # Ex.: "10733,10738"
kitt.Quests.AutoReputation.List = ""

########################################
# TELEGRAM CHAT BOT SETTINGS
########################################

# Activeaza sau dezactiveaza botul (1 = Pornit, 0 = Oprit)
Kitt.Telegram.Enable = 0

# Token-ul primit de la @BotFather
Kitt.Telegram.Token = ""

# ID-ul de chat (ex: -10054321) daca chatID este: 54321
Kitt.Telegram.ChatId = "-100"

# Numele canalului care va fi monitorizat (litere mici)
Kitt.Telegram.Channel = "global"

# program noapte start interval H 0...23
# to disabled set 0 to start and end
Kitt.Telegram.NightStart = 0

# program noapte end
Kitt.Telegram.NightEnd = 0

# anti-spam doar pt canal setat
# interval secunde
Kitt.Telegram.SpamTime = 5

# nr msg in interval
Kitt.Telegram.SpamCount = 2

# mute time in secunde
Kitt.Telegram.MuteTime = 60

